# ============================================================
# Con Cariño PR — PRODUCTION environment template
# Copy values from the PRODUCTION backend only. Never reuse staging keys.
# ============================================================

# ---- Browser-visible (bundled into JS) — public keys ONLY ----
VITE_SITE_URL="https://app.example.com"
VITE_SUPABASE_URL="https://<prod-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<prod-publishable-anon-key>"
VITE_SUPABASE_PROJECT_ID="<prod-project-ref>"

# ---- Server-only (runtime secrets — NEVER prefix with VITE_) ----
SUPABASE_SERVICE_ROLE_KEY="<prod-service-role-key>"
SUPABASE_DB_URL="postgresql://postgres:<password>@db.<prod-project-ref>.supabase.co:5432/postgres?sslmode=require"

# SMS (use LIVE credentials, not sandbox numbers)
TWILIO_ACCOUNT_SID="AC<live-sid>"
TWILIO_AUTH_TOKEN="<live-token>"
TWILIO_FROM_PHONE_NUMBER="+1787XXXXXXX"

# Email
TRANSACTIONAL_EMAIL_API_KEY="<live-key>"
EMAIL_FROM_ADDRESS="notificaciones@example.com"

# Payments (live mode keys start with sk_live_ / pk_live_)
# STRIPE_SECRET_KEY="sk_live_..."

# Logging
LOG_DRAIN_ENDPOINT=""
SENTRY_DSN=""

# ---- Pre-flight checklist ----
# [ ] No value above contains "test", "sandbox", or the staging project ref
# [ ] grep -r "service_role" dist/  returns nothing
# [ ] Staging keys rotated/revoked after cutover
